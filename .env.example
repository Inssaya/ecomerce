# ── MoStyle — environment ─────────────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# One database. The eight per-service databases were merged in Phase 0, which
# is what allows real foreign keys between products, orders and users.
POSTGRES_USER=mostyle
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=mostyle

# ── JWT ───────────────────────────────────────────────────────────────────────
# Required — the API refuses to authenticate anyone without it.
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_long_random_secret_at_least_64_chars

# ── MinIO (photography storage) ───────────────────────────────────────────────
MINIO_ROOT_USER=mostyle_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
# The host a phone browser can reach the photos on.
# Development: localhost:9000     Production: media.mostyle.ma
MINIO_PUBLIC_ENDPOINT=localhost:9000

# Hosts the storefront is allowed to load photographs from, comma separated.
# Next refuses images from anywhere else, so an empty value in production means
# every product photo is silently broken. MinIO on localhost is always allowed.
# Production: media.mostyle.ma
MEDIA_HOSTNAMES=

# ── Email ─────────────────────────────────────────────────────────────────────
# Development: `docker compose --profile dev up` runs Mailpit, which catches
# every outgoing message at http://localhost:8025 instead of sending it.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=workshop@mostyle.ma
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

# ── The workshop ──────────────────────────────────────────────────────────────
APP_NAME=MoStyle
# Public URL of the site. The most consequential value in this file: the
# backend builds tracking links, quote links and password-reset links from it
# and emails them to customers, and the storefront builds every canonical URL,
# hreflang pair, sitemap entry and share card from it. Left at localhost, every
# link the shop sends is dead and Google is told the site lives somewhere else.
# Production: https://mostyle.ma
APP_URL=http://localhost:3000
ENVIRONMENT=production

# International format, no + and no spaces: 2126xxxxxxxx.
# Used for the click-to-chat handoff on orders, and — because in this market
# the WhatsApp number *is* the business number — as the shop's telephone in the
# structured data every search engine reads. Use the same number here, on your
# Google Business Profile and anywhere else you list the shop: local search
# rewards one business saying one number everywhere. Leave empty to omit it
# rather than publish a wrong one.
WHATSAPP_NUMBER=

# ── AI ────────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. An empty key makes both the shopping
# concierge and the owner's copilot report themselves unavailable rather than
# degrade to a guess.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Cash on delivery, MAD, Morocco ────────────────────────────────────────────
# Stated on the page before checkout. A fee discovered at the door is a refused
# package, and a refused package is the largest silent cost in this market.
#
# This is the fee for anywhere the shop has not named. A city row may carry its
# own, for somewhere that genuinely costs more to reach, and that one wins —
# the city page, the cart, the checkout and the till all read the same answer,
# so there is nothing to keep in sync. Above FREE_DELIVERY_OVER nothing is
# charged, expensive city or not.
DELIVERY_FEE=30
FREE_DELIVERY_OVER=500

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Sending real email ────────────────────────────────────────────────────────
# Order updates and quotes are emailed. Without SPF and DKIM records on the
# domain, Gmail puts every one of them in spam — and a customer who never sees
# "your order is on its way" is a customer who refuses the package at the door.
# Use a sending service (Resend, Brevo, Postmark), add the DNS records it gives
# you, then set:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=<the api key>
#   SMTP_TLS=true
#   SMTP_FROM=workshop@mostyle.ma
