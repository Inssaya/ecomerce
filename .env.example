# ──────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────
POSTGRES_USER=ecomerce
POSTGRES_PASSWORD=ecomerce_secret

# ──────────────────────────────────────────
# Redis
# ──────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ──────────────────────────────────────────
# RabbitMQ
# ──────────────────────────────────────────
RABBITMQ_USER=ecomerce
RABBITMQ_PASSWORD=ecomerce_secret

# ──────────────────────────────────────────
# Meilisearch
# ──────────────────────────────────────────
MEILI_MASTER_KEY=ecomerce_meili_master_key_changeme

# ──────────────────────────────────────────
# MinIO (S3-compatible object storage)
# ──────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret

# ──────────────────────────────────────────
# JWT Auth
# ──────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=changeme_generate_a_real_secret_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256

# ──────────────────────────────────────────
# Email (SMTP)
# ──────────────────────────────────────────
# In dev, Mailpit catches all outbound email at http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@ecomerce.ma
# For production, set SMTP credentials here:
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true

# ──────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Ecomerce
