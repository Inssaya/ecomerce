# ── MoStyle — Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in production values.
# NEVER commit .env to git.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=mostyle
POSTGRES_PASSWORD=change_me_strong_password_here

# ── Redis ──────────────────────────────────────────────────────────────────────
# No password by default; for production add a requirepass in redis config.

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
RABBITMQ_USER=mostyle
RABBITMQ_PASSWORD=change_me_rabbitmq_password

# ── Meilisearch ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
MEILI_MASTER_KEY=change_me_meilisearch_master_key
# Use "production" to disable the search preview UI
MEILI_ENV=production

# ── MinIO (S3-compatible object storage) ───────────────────────────────────────
MINIO_ROOT_USER=mostyle_admin
MINIO_ROOT_PASSWORD=change_me_minio_password

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_long_random_secret_at_least_64_chars
JWT_ALGORITHM=HS256

# ── SMTP (email) ───────────────────────────────────────────────────────────────
# Development: Mailpit catches all outbound email at http://localhost:8025
# Production: replace with your SMTP provider (SendGrid, Mailgun, SES, etc.)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@mostyle.ma
SMTP_USER=
SMTP_PASSWORD=
# Set to "true" for production SMTP with TLS (e.g. port 587)
SMTP_TLS=false
APP_NAME=MoStyle

# ── Frontend ───────────────────────────────────────────────────────────────────
# Public URL of the API gateway (used by browser-side Next.js code)
# Development: http://localhost:8000
# Production:  https://api.mostyle.ma
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=production
