# MoStyle — the Oracle VM's .env, for docker-compose.oracle.yml.
# Copy to .env on the VM and fill in real values. Never commit it.
#
# This is a subset of the repo's main .env.example: no POSTGRES_*, no
# MINIO_ROOT_*, no NEXT_PUBLIC_* — this box runs only the API and Redis.
# The database is Supabase, the photos are Cloudflare R2, the frontend is
# Vercel. See docs/DEPLOY-FREE.md.

APP_NAME=MoStyle
# The Vercel address — every tracking link and reset link in every email is
# built from it. Production: https://mostyle.ma or https://your-app.vercel.app
APP_URL=

# Supabase's pooled connection string (port 6543, Transaction pooler),
# prefixed postgresql+asyncpg:// — SQLAlchemy picks the driver from that
# prefix, and the string Supabase shows you starts postgresql://.
DATABASE_URL=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx

# Cloudflare R2, over the S3 API.
MINIO_ENDPOINT=your-account-id.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MEDIA_BUCKET=ecomerce

SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=workshop@mostyle.ma
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

WHATSAPP_NUMBER=

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

DELIVERY_FEE=0
FREE_DELIVERY_OVER=0
